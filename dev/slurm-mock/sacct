#!/usr/bin/env node
// Mock sacct [-j jobid] [--parsable2] — job accounting, includes terminal jobs.
import { loadScenario, listJobs, ensureSeeded, elapsedHms } from "../mock-bin/lib.mjs";

const scenario = loadScenario();
ensureSeeded("slurm", scenario);

const args = process.argv.slice(2);
let jobFilter = null;
let parsable = false;
for (let i = 0; i < args.length; i++) {
  if (args[i] === "-j" || args[i] === "--jobs") jobFilter = String(args[i + 1]);
  if (args[i] === "--parsable2" || args[i] === "-P") parsable = true;
}

const header = ["JobID", "JobName", "Partition", "Account", "AllocCPUS", "State", "ExitCode", "Elapsed"];
const rows = [];
for (const j of listJobs("slurm")) {
  if (jobFilter && String(j.id) !== jobFilter) continue;
  const exitCode = j.state === "FAILED" ? "1:0" : "0:0";
  rows.push([j.id, j.name, j.partition, "(null)", 4, j.state, exitCode, elapsedHms(j.startTime)]);
}

if (parsable) {
  process.stdout.write([header.join("|"), ...rows.map(r => r.join("|")), ""].join("\n"));
} else {
  const widths = header.map((h, i) => Math.max(h.length, ...rows.map(r => String(r[i]).length)));
  const fmt = (r) => r.map((c, i) => String(c).padEnd(widths[i])).join(" ");
  process.stdout.write([fmt(header), fmt(widths.map(w => "-".repeat(w))), ...rows.map(fmt), ""].join("\n"));
}
