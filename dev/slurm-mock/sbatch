#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import { loadScenario, nextJobId, writeJob, currentUser, ensureSeeded, runIfEnabled } from "../mock-bin/lib.mjs";

const scenario = loadScenario();
ensureSeeded("slurm", scenario);

const args = process.argv.slice(2);
const script = args[args.length - 1];
if (!script) {
  process.stderr.write("sbatch: please submit a script\n");
  process.exit(1);
}

let jobName = `mockjob`;
let partition = scenario.queues?.find(q => q.default)?.name || "main";
let timelimit = "01:00:00";
let workdir = process.cwd();
let output = "slurm-%j.out";
if (fs.existsSync(script)) {
  workdir = path.dirname(path.resolve(script));
  const text = fs.readFileSync(script, "utf-8");
  const nameMatch = text.match(/^#SBATCH\s+--job-name=(\S+)/m);
  if (nameMatch) jobName = nameMatch[1];
  const partMatch = text.match(/^#SBATCH\s+--partition=(\S+)/m);
  if (partMatch) partition = partMatch[1];
  const timeMatch = text.match(/^#SBATCH\s+--time=(\S+)/m);
  if (timeMatch) timelimit = timeMatch[1];
  const outMatch = text.match(/^#SBATCH\s+--output=(\S+)/m);
  if (outMatch) output = outMatch[1];
}

if (!scenario.queues?.some(q => q.name === partition)) {
  process.stderr.write(`sbatch: error: invalid partition specified: ${partition}\n`);
  process.exit(1);
}

const id = nextJobId("slurm");
writeJob("slurm", {
  id,
  name: jobName,
  user: currentUser(),
  state: "RUNNING",
  partition,
  queue: partition,
  priority: 100,
  timelimit,
  held: false,
  startTime: new Date().toISOString(),
  workdir,
  script,
});

runIfEnabled("slurm", id, script, workdir, output.replace(/%j/g, String(id)));

// Like real sbatch: the bare id only with --parsable.
process.stdout.write((args.includes("--parsable") ? String(id) : `Submitted batch job ${id}`) + "\n");
