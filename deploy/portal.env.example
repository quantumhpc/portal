# QuantumHPC Portal — environment (installed as /etc/qhpc-portal/portal.env, mode 0600)
NODE_ENV=production

# Public URL users browse to (must match the reverse proxy)
NEXTAUTH_URL=https://portal.example.org
# Random secret used to sign sessions: openssl rand -base64 48
NEXTAUTH_SECRET=change-me

# Listen only on localhost; nginx terminates TLS in front
HOSTNAME=127.0.0.1
PORT=3000

# Site configuration directory (config.json, managers/)
QHPC_CONFIG_DIR=/etc/qhpc-portal

# Optional overrides (otherwise read from config.json)
# HPC_MANAGER=slurm
# ADMIN_USERS=alice,bob
# DB_DRIVER=sqlite
# SQLITE_FILE=/var/lib/qhpc-portal/qhpc.sqlite
# LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
