# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev artifacts
/dev/keys/
/dev/qhpc.sqlite
/dev/qhpc.sqlite-*


# site-local configuration (copy config/config.example.json to start)
/config/config.json
/config/*.local.json
# site applications, logos and parsers (Admin → Applications)
/config/apps/
/data/

# vendor license-server utilities (lmutil, rlmutil, lmxendutil) — never commit
/binaries/

# secrets — never commit
*.key
*.lic
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.csv
*.sqlite
*.sqlite-*
*.db

# editor / assistant local settings
.claude/settings.local.json
.vscode/launch.json

# MkDocs build output
/site/
